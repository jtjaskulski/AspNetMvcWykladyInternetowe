@{
    ViewData["Title"] = "Contact";
}

<!-- Hero -->
<section class="relative pt-32 pb-20 bg-gradient-to-br from-gray-950 via-gray-900 to-indigo-950">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 animate-fade-in">
            Get in <span class="bg-gradient-to-r from-violet-400 to-indigo-400 bg-clip-text text-transparent">Touch</span>
        </h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto animate-slide-up">
            Have questions about the course or this project? Drop us a message.
        </p>
    </div>
</section>

<!-- Contact Form + Info -->
<section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-16">

            <!-- Form -->
            <div class="lg:col-span-3">
                <h2 class="text-2xl font-bold text-gray-900 mb-8">Send a Message</h2>
                <form class="space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                            <input type="text" placeholder="Jan"
                                   class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10 transition-all duration-200" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                            <input type="text" placeholder="Kowalski"
                                   class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10 transition-all duration-200" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                        <input type="email" placeholder="jan@example.com"
                               class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10 transition-all duration-200" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Subject</label>
                        <select class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-800 focus:outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10 transition-all duration-200">
                            <option value="">Choose a topic...</option>
                            <option>Question about SCSS</option>
                            <option>Question about Flexbox</option>
                            <option>Question about Tailwind</option>
                            <option>General inquiry</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Message</label>
                        <textarea rows="5" placeholder="Tell us what's on your mind..."
                                  class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10 transition-all duration-200 resize-none"></textarea>
                    </div>
                    <button type="submit"
                            class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-violet-600 to-indigo-600 text-white font-semibold rounded-xl shadow-lg shadow-violet-600/25 hover:shadow-violet-600/40 hover:-translate-y-0.5 transition-all duration-200">
                        Send Message
                    </button>
                </form>
            </div>

            <!-- Info Cards -->
            <div class="lg:col-span-2 space-y-6">
                <h2 class="text-2xl font-bold text-gray-900 mb-8">Contact Info</h2>

                <div class="group p-6 bg-gray-50 rounded-2xl border border-gray-100 hover:bg-violet-50 hover:border-violet-200 transition-all duration-300">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-violet-100 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-violet-200 transition-colors">
                            <span class="material-icons-outlined text-violet-600">location_on</span>
                        </div>
                        <div>
                            <h4 class="font-semibold text-gray-900 mb-1">Address</h4>
                            <p class="text-gray-500 text-sm">WSB-NLU University<br>Nowy Sącz, Poland</p>
                        </div>
                    </div>
                </div>

                <div class="group p-6 bg-gray-50 rounded-2xl border border-gray-100 hover:bg-indigo-50 hover:border-indigo-200 transition-all duration-300">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-indigo-200 transition-colors">
                            <span class="material-icons-outlined text-indigo-600">email</span>
                        </div>
                        <div>
                            <h4 class="font-semibold text-gray-900 mb-1">Email</h4>
                            <p class="text-gray-500 text-sm">contact@techstore.edu</p>
                        </div>
                    </div>
                </div>

                <div class="group p-6 bg-gray-50 rounded-2xl border border-gray-100 hover:bg-pink-50 hover:border-pink-200 transition-all duration-300">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-pink-100 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-pink-200 transition-colors">
                            <span class="material-icons-outlined text-pink-600">schedule</span>
                        </div>
                        <div>
                            <h4 class="font-semibold text-gray-900 mb-1">Office Hours</h4>
                            <p class="text-gray-500 text-sm">Mon — Fri: 8:00 — 16:00<br>Sat: 9:00 — 13:00</p>
                        </div>
                    </div>
                </div>

                <div class="p-6 bg-gradient-to-br from-violet-600 to-indigo-600 rounded-2xl text-white">
                    <h4 class="font-semibold mb-2">Quick Tip</h4>
                    <p class="text-violet-200 text-sm leading-relaxed">
                        This form demonstrates Tailwind's form styling: <code class="bg-white/10 px-1.5 py-0.5 rounded text-xs">focus:ring-4</code>, <code class="bg-white/10 px-1.5 py-0.5 rounded text-xs">focus:border-violet-500</code>, and responsive grid via <code class="bg-white/10 px-1.5 py-0.5 rounded text-xs">sm:grid-cols-2</code>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
