@{
    ViewData["Title"] = "Products";
}

<!-- Hero -->
<section class="relative pt-32 pb-20 bg-gradient-to-br from-gray-950 via-gray-900 to-indigo-950">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 animate-fade-in">
            Our <span class="bg-gradient-to-r from-violet-400 to-indigo-400 bg-clip-text text-transparent">Products</span>
        </h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto animate-slide-up">
            A Flexbox-powered product gallery. Resize the browser to see responsive layout in action.
        </p>
    </div>
</section>

<!-- Flexbox Explanation Banner -->
<section class="py-8 bg-violet-50 border-b border-violet-100">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
            <span class="font-semibold text-violet-700">Flexbox concepts on this page:</span>
            <code class="px-3 py-1 bg-white border border-violet-200 rounded-lg text-violet-600 font-mono text-xs">display: flex</code>
            <code class="px-3 py-1 bg-white border border-violet-200 rounded-lg text-violet-600 font-mono text-xs">flex-wrap: wrap</code>
            <code class="px-3 py-1 bg-white border border-violet-200 rounded-lg text-violet-600 font-mono text-xs">gap</code>
            <code class="px-3 py-1 bg-white border border-violet-200 rounded-lg text-violet-600 font-mono text-xs">flex: 1 1 300px</code>
            <code class="px-3 py-1 bg-white border border-violet-200 rounded-lg text-violet-600 font-mono text-xs">flex-direction: column</code>
        </div>
    </div>
</section>

<!-- Filter Bar (Flexbox: justify-between, items-center, gap, flex-wrap) -->
<section class="py-8 bg-white border-b border-gray-100 sticky top-16 z-40 backdrop-blur-xl bg-white/90">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-2">
                <button class="px-4 py-2 bg-gray-900 text-white text-sm font-medium rounded-full transition">All</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-full hover:bg-gray-200 transition">Laptops</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-full hover:bg-gray-200 transition">Phones</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-full hover:bg-gray-200 transition">Audio</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-full hover:bg-gray-200 transition">Accessories</button>
            </div>
            <p class="text-sm text-gray-400">Showing <span class="font-semibold text-gray-700">8</span> products</p>
        </div>
    </div>
</section>

