<!-- Flexbox Demo Section -->
<section class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-gray-900 mb-4 text-center">How This Layout Works</h2>
        <p class="text-gray-500 text-center mb-12">The product grid above uses these Flexbox properties:</p>

        <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <div class="flex items-start gap-4">
                    <code class="px-3 py-1.5 bg-violet-100 text-violet-700 text-sm font-mono rounded-lg whitespace-nowrap shrink-0">display: flex</code>
                    <p class="text-gray-600 text-sm">The container becomes a flex container. All direct children (product cards) become flex items laid out in a row.</p>
                </div>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <div class="flex items-start gap-4">
                    <code class="px-3 py-1.5 bg-pink-100 text-pink-700 text-sm font-mono rounded-lg whitespace-nowrap shrink-0">flex-wrap: wrap</code>
                    <p class="text-gray-600 text-sm">When cards can't fit in one row, they wrap to the next line — creating a responsive grid without media queries.</p>
                </div>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <div class="flex items-start gap-4">
                    <code class="px-3 py-1.5 bg-indigo-100 text-indigo-700 text-sm font-mono rounded-lg whitespace-nowrap shrink-0">flex: 1 1 280px</code>
                    <p class="text-gray-600 text-sm">Each card can grow (<code class="text-xs bg-gray-200 px-1 rounded">flex-grow: 1</code>), can shrink (<code class="text-xs bg-gray-200 px-1 rounded">flex-shrink: 1</code>), and starts at 280px minimum (<code class="text-xs bg-gray-200 px-1 rounded">flex-basis: 280px</code>).</p>
                </div>
            </div>
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <div class="flex items-start gap-4">
                    <code class="px-3 py-1.5 bg-emerald-100 text-emerald-700 text-sm font-mono rounded-lg whitespace-nowrap shrink-0">gap: 24px</code>
                    <p class="text-gray-600 text-sm">Modern spacing between flex items — replaces the old margin hack. Works like grid-gap but for Flexbox containers.</p>
                </div>
            </div>
        </div>
    </div>
</section>
