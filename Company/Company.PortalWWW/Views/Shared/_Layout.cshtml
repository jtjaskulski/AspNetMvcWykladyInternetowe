<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Company.PortalWWW</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="flex flex-col min-h-screen bg-gray-50">

    <nav class="bg-sky-400" role="navigation">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <a id="logo-container" href="#" class="text-xl font-bold text-white no-underline">WSB-NLU MVC</a>

            <button id="mobile-menu-btn" class="md:hidden text-white focus:outline-none">
                <i class="material-icons text-3xl">menu</i>
            </button>

            <ul class="hidden md:flex space-x-6 list-none m-0 p-0">
                <li>@Html.ActionLink("Strona główna", "Index", "Home", null, new { @class = "text-white hover:text-sky-100 transition no-underline" })</li>
                <li>@Html.ActionLink("O firmie", "About", "Home", null, new { @class = "text-white hover:text-sky-100 transition no-underline" })</li>
                <li>@Html.ActionLink("Kontakt", "Contact", "Home", null, new { @class = "text-white hover:text-sky-100 transition no-underline" })</li>
            </ul>
        </div>

        <div id="mobile-menu" class="hidden md:hidden bg-sky-500 px-4 pb-4">
            <ul class="list-none m-0 p-0 space-y-2">
                <li>@Html.ActionLink("Strona główna", "Index", "Home", null, new { @class = "block text-white hover:text-sky-100 transition no-underline py-2" })</li>
                <li>@Html.ActionLink("O firmie", "About", "Home", null, new { @class = "block text-white hover:text-sky-100 transition no-underline py-2" })</li>
                <li>@Html.ActionLink("Kontakt", "Contact", "Home", null, new { @class = "block text-white hover:text-sky-100 transition no-underline py-2" })</li>
            </ul>
        </div>
    </nav>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <section class="max-w-7xl mx-auto px-4 py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
                <i class="material-icons text-5xl text-sky-500">flash_on</i>
                <h5 class="text-xl font-semibold mt-4 mb-2">O sklepie</h5>
                <p class="text-gray-600 font-light">Sklep jest doskonały. Sklep jest doskonały. Sklep jest doskonały. Sklep jest doskonały</p>
            </div>

            <div class="text-center">
                <i class="material-icons text-5xl text-sky-500">group</i>
                <h5 class="text-xl font-semibold mt-4 mb-2">O firmie</h5>
                <p class="text-gray-600 font-light">Firma jest doskonała. Firma jest doskonała Firma jest doskonała Firma jest doskonała Firma jest doskonała Firma jest doskonała</p>
            </div>

            <div class="text-center">
                <i class="material-icons text-5xl text-sky-500">settings</i>
                <h5 class="text-xl font-semibold mt-4 mb-2">O towarach</h5>
                <p class="text-gray-600 font-light">Towary są doskonałe Towary są doskonałe Towary są doskonałe Towary są doskonałe</p>
            </div>
        </div>
    </section>

    <footer class="bg-orange-500 text-white mt-auto">
        <div class="max-w-7xl mx-auto px-4 py-10">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="lg:col-span-2">
                    <h5 class="text-lg font-semibold mb-2">WSB-NLU</h5>
                    <p class="text-orange-100">Witamy</p>
                </div>
                <div>
                    <h5 class="text-lg font-semibold mb-2">Settings</h5>
                    <ul class="list-none m-0 p-0 space-y-1">
                        <li><a class="text-white hover:text-orange-200 transition no-underline" href="#!">Link 1</a></li>
                        <li><a class="text-white hover:text-orange-200 transition no-underline" href="#!">Link 2</a></li>
                        <li><a class="text-white hover:text-orange-200 transition no-underline" href="#!">Link 3</a></li>
                        <li><a class="text-white hover:text-orange-200 transition no-underline" href="#!">Link 4</a></li>
                    </ul>
                </div>
                <div>
                    <h5 class="text-lg font-semibold mb-2">Connect</h5>
                    <ul class="list-none m-0 p-0 space-y-1">
                        <li><a class="text-white hover:text-orange-200 transition no-underline" href="#!">Link 1</a></li>
                        <li><a class="text-white hover:text-orange-200 transition no-underline" href="#!">Link 2</a></li>
                        <li><a class="text-white hover:text-orange-200 transition no-underline" href="#!">Link 3</a></li>
                        <li><a class="text-white hover:text-orange-200 transition no-underline" href="#!">Link 4</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="border-t border-orange-400">
            <div class="max-w-7xl mx-auto px-4 py-4 text-sm text-orange-100">
                Made by WSB-NLU
            </div>
        </div>
    </footer>

    <script>
        document.getElementById('mobile-menu-btn').addEventListener('click', function () {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
